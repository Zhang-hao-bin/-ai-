# 复制为 .env；不配置时仍可检索原文，不会调用模型。
LLM_API_KEY=
LLM_MODEL=
# 可选：服务提供商的 OpenAI 兼容 Chat Completions 地址
LLM_BASE_URL=
# 本地模型较慢时可提高超时（秒），控制最大输出长度。
LLM_TIMEOUT=180
LLM_MAX_TOKENS=1500
# Qwen 的 vLLM 服务可设置以下选项；其他提供商留空或用 {}。
LLM_EXTRA_BODY={}

# 上下文容量必须与实际服务一致；vLLM 可配置分词接口，以准确控制历史预算。
LLM_CONTEXT_WINDOW=8192
LLM_TOKENIZER_URL=
